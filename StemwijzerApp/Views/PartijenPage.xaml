<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StemwijzerApp.Models"
             x:Class="StemwijzerApp.PartijenPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Border Margin="16"
            Padding="16"
            BackgroundColor="#F4F4F4"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="12">

            <Label Text="‹"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="Black">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Row="1"
                   Text="Lijst van alle Mogelijke Partijen"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalTextAlignment="Center" />

            <CollectionView Grid.Row="2"
                            x:Name="PartijenList"
                            SelectionMode="Single"
                            SelectionChanged="OnPartijSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Partij">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                              ColumnSpacing="10"
                              Padding="0,8">
                            <Border WidthRequest="36"
                                    HeightRequest="36"
                                    BackgroundColor="#2BA39B"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <Label Text="!!"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="{Binding Nummer, StringFormat='{0}.'}"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="{Binding Naam}"
                                   TextColor="Black"
                                   WidthRequest="80"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="3"
                                   Text="{Binding Beschrijving}"
                                   TextColor="Black"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="4"
                                   Text="›"
                                   FontSize="22"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Border>
</ContentPage>