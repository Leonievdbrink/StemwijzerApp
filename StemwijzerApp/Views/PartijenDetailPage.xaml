<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StemwijzerApp.PartijDetailPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Border Margin="16"
            Padding="16"
            BackgroundColor="#F4F4F4"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20">
        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="16">

            <Label Text="‹"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="Black">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>

            <HorizontalStackLayout Grid.Row="1"
                                   Spacing="12">
                <Border WidthRequest="36"
                        HeightRequest="36"
                        BackgroundColor="#2BA39B"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">
                    <Label Text="!!"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding Kort}"
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="Black"
                       VerticalOptions="Center" />
                <Label Text="{Binding Naam}"
                       FontSize="14"
                       TextColor="Black"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Voorzitter, StringFormat='Voorzitter: {0}'}"
                           FontSize="14"
                           TextColor="Black" />
                    <Label Text="{Binding Beschrijving}"
                           FontSize="16"
                           TextColor="Black" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</ContentPage>